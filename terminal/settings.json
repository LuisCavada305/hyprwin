            "brightRed": "#EB6F92",
            "brightWhite": "#E0DEF4",
            "brightYellow": "#F6C177",
            "cursorColor": "#E0DEF4",
            "cyan": "#EBBCBA",
            "foreground": "#E0DEF4",
            "green": "#31748F",
            "name": "Ros\u00e9 Pine",
